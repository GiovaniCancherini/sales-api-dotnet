# Copy to .env (git-ignored) and fill every value before running docker compose.
# Use letters and digits only: the Mongo password goes inside a URL.
# Generate a random value in PowerShell:
#   -join (1..32 | ForEach-Object { "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"[[Security.Cryptography.RandomNumberGenerator]::GetInt32(62)] })
# or in bash:
#   tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32

POSTGRES_PASSWORD=
MONGO_PASSWORD=
REDIS_PASSWORD=

# Signs the API's JWTs. At least 32 characters; the API refuses to start otherwise.
JWT_SECRET_KEY=
